  "automod_rules": [
    {
      "key": "common-flagged-words",
      "name": "Common Flagged Words",
      "enabled": true,
      "trigger": {
        "type": "keyword_preset",
        "presets": [
          "profanity",
          "sexual_content",
          "slurs"
        ],
        "allow_list": []
      },
      "actions": [
        {
          "type": "block_message",
          "custom_message": "Your message was blocked by CloudNow AutoMod. Remove prohibited content and try again."
        },
        {
          "type": "send_alert",
          "channel": "automod-alerts"
        }
      ],
      "exempt_roles": [],
      "exempt_channels": [
        "security-response"
      ]
    },
    {
      "key": "spam-content",
      "name": "Spam Content",
      "enabled": true,
      "trigger": {
        "type": "spam"
      },
      "actions": [
        {
          "type": "block_message",
          "custom_message": "Your message was blocked as likely spam. Remove repetitive or deceptive content and try again."
        },
        {
          "type": "send_alert",
          "channel": "automod-alerts"
        }
      ],
      "exempt_roles": [],
      "exempt_channels": []
    },
    {
      "key": "mention-spam",
      "name": "Mention Spam",
      "enabled": true,
      "trigger": {
        "type": "mention_spam",
        "mention_limit": 5,
        "mention_raid_protection": true
      },
      "actions": [
        {
          "type": "block_message",
          "custom_message": "Your message contained too many mentions. Reduce them and try again."
        },
        {
          "type": "send_alert",
          "channel": "automod-alerts"
        },
        {
          "type": "timeout",
          "duration_seconds": 60
        }
      ],
      "exempt_roles": [],
      "exempt_channels": []
    },
    {
      "key": "scam-and-qr-review",
      "name": "Scam and QR Review (Alert Only)",
      "enabled": true,
      "alert_only": true,
      "trigger": {
        "type": "keyword",
        "keywords": [
          "*free nitro*",
          "*nitro giveaway claim*",
          "*steam gift login*",
          "*verify by scanning this QR*",
          "*scan this QR code*",
          "*crypto airdrop*",
          "*wallet verification*",
          "*token grabber*",
          "*password checker*",
          "*account generator*",
          "*DM me for support*",
          "*staff verification required*"
        ],
        "regex_patterns": [],
        "allow_list": []
      },
      "actions": [
        {
          "type": "send_alert",
          "channel": "automod-alerts"
        }
      ],
      "exempt_roles": [],
      "exempt_channels": []
    },
    {
      "key": "suspicious-distribution",
      "name": "Suspicious CloudNow Distribution (Alert Only)",
      "enabled": true,
      "alert_only": true,
      "trigger": {
        "type": "keyword",
        "keywords": [
          "*paid CloudNow IPA*",
          "*cracked CloudNow*",
          "*modded CloudNow download*",
          "*DM for CloudNow build*",
          "*private CloudNow download*"
        ],
        "regex_patterns": [],
        "allow_list": []
      },
      "actions": [
        {
          "type": "send_alert",
          "channel": "automod-alerts"
        }
      ],
      "exempt_roles": [],
      "exempt_channels": []
    }
  ]
