# Configured for SwiftFormat 0.62.1 — pin in .pre-commit-config.yaml and .github/workflows/lint.yml
# Day-1 ruleset: defaults tuned for CloudNow's existing style (zero tabs, 4-space indent).
# Run "swiftformat --config .swiftformat CloudNow CloudNowTests CloudNowUITests" to apply; "--lint" to verify.

# Targets Swift 5.10 syntax conventions while the Xcode 26 project remains in Swift 5 mode.
--swiftversion 5.10

# CloudNow uses 4-space indentation throughout (zero tabs detected).
--indent 4

# Line-length policing is SwiftLint's job (and currently disabled there too — see .swiftlint.yml).
# File consistency > arbitrary cutoffs while max-line is 233 chars.
--maxwidth none

# Do NOT touch file headers — CloudNow has none today; don't inject copyright noise.
--header ignore

# Skip build, test-artifact, and SPM checkout dirs (mirrors .swiftlint.yml's excluded list).
--exclude .build,.swiftpm,DerivedData,Packages,TestArtifacts,.spm-packages
